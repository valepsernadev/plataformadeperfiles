APP_NAME="Plataforma de Perfiles"
APP_ENV=local
# Sin valor a propósito: este archivo SÍ se versiona, y la APP_KEY es la clave
# que cifra y descifra `tarjetas.numero_tarjeta`. Se genera en cada entorno con
# `php artisan key:generate` (o `sail artisan key:generate`). Nunca se copia
# la clave real de un entorno a este archivo (guía, sección 7).
APP_KEY=
# `false` a propósito: manejo de errores genérico hacia el usuario, sin stack
# traces ni detalles de la base de datos (guía, sección 7).
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Usuario y grupo con los que corre Sail dentro del contenedor. El Dockerfile
# de Sail los usa sin valor por defecto (`groupadd -g $WWWGROUP`), así que si
# faltan, la construcción de la imagen falla.
WWWGROUP=1000
WWWUSER=1000

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# PostgreSQL, servido por el contenedor `pgsql` de compose.yaml. `DB_HOST` es
# el nombre del servicio: dentro de la red de Docker se resuelve por DNS.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=plataforma_perfiles
DB_USERNAME=sail
DB_PASSWORD=password

# Ejemplo para MySQL (requiere `sail:install --with=mysql` o un servidor aparte):
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=plataforma_perfiles
# DB_USERNAME=sail
# DB_PASSWORD=password

# ---------------------------------------------------------------------------
# Sesión -- guía, secciones 5 y 7
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
# Expiración por inactividad. Una sesión sin caducidad es una vulnerabilidad
# listada en la guía (sección 5).
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# HttpOnly + Secure + SameSite=Strict, los tres exigidos por la guía.
# NOTA: `Secure` significa que el navegador solo devuelve la cookie por HTTPS.
# Chrome, Edge y Firefox tratan http://localhost como origen seguro, así que
# en desarrollo local funciona igual. Si accedes por un host que NO sea
# localhost sobre HTTP plano (p. ej. http://192.168.1.50), el login fallará
# porque el navegador descarta la cookie: en ese caso pon esta variable en
# `false` o sirve la aplicación por HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@plataformadeperfiles.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
